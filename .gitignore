__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# pipeline outputs, and any audio (reference songs must never be committed)
out/
inputs/
*.mid
*.midi
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.opus
*.webm
!tests/**/*.mid

# guided /try/ demo: the stemscribe run stays local; of the frozen page built from
# it, only the song's data is tracked (House Of The Rising Sun by HoliznaCC0, CC0),
# so CI can build the site. The page code there is a copy deploy-web.sh replaces.
try-work/
try-dist/*
!try-dist/try/
try-dist/try/*
!try-dist/try/data.json
!try-dist/try/mix.mp3
!try-dist/try/stems/
!try-dist/try/stems/*.mp3

# the Hugging Face Space as staged for pushing (scripts/stage_space.py)
space-dist/

# local scratch: probe scripts, test clips, screenshots
scratch/

# secrets (yt-dlp cookie exports, env files, HF tokens)
.env
.env.*
cookies*.txt
*.cookies

# model weights (multi-GB; live in the HF cache, never in the repo)
*.safetensors
*.onnx
*.pt
*.th
*.ckpt

# the browser engine's sources install and build here; its exported models
# (browser/models/*) and verification output stay local
browser/node_modules/
browser/models-out/
browser/verify/out/
# the public model repo as staged for upload (scripts/stage_models.py): README.md and
# models.json are tracked, the .onnx files stay out (*.onnx above)
models-dist/*.onnx

# macOS
.DS_Store
